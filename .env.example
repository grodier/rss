RSS_DB_DSN=postgres://rssapp:dev-password@localhost:5432/rssapp_dev?sslmode=disable

# Mailpit (started by make db/start) catches the app's email and shows it at
# http://localhost:8025. Remove these two lines to make the app log emails instead.
RSS_SMTP_HOST=localhost
RSS_SMTP_PORT=1025

# The admin site's key for admins' TOTP secrets (admin enroll and admin serve
# both need it): openssl rand -hex 32.
# RSS_SECRET_KEY=...

# Newsletters: readers' addresses are at this domain, and make inbound/post
# signs emails with the secret (any random value: openssl rand -hex 32).
# RSS_NEWSLETTER_DOMAIN=in.localhost
# RSS_INBOUND_SECRET=...

# Your local account, created by make db/seed (and make db/reset).
# RSS_DEV_EMAIL=you@example.com
# RSS_DEV_PASSWORD=...
# RSS_DEV_NAME=You
