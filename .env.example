RSS_DB_DSN=postgres://rssapp:dev-password@localhost:5432/rssapp_dev?sslmode=disable

# Mailpit (started by make db/start) catches the app's email and shows it at
# http://localhost:8025. Remove these two lines to make the app log emails instead.
RSS_SMTP_HOST=localhost
RSS_SMTP_PORT=1025

# Your local account, created by make db/seed (and make db/reset).
# RSS_DEV_EMAIL=you@example.com
# RSS_DEV_PASSWORD=...
# RSS_DEV_NAME=You
